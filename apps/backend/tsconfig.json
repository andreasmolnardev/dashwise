{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "emitDeclarationOnly": false,
    "rootDir": "../..",
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "lib": ["esnext"],
    "types": [
      "bun"
    ],
    "paths": {
      "@dashwise/assets": ["../../packages/assets/index.ts"],
      "@dashwise/assets/*": ["../../packages/assets/*"],
      "@dashwise/sdk": ["../../packages/sdk/index.ts"],
      "@dashwise/sdk/index": ["../../packages/sdk/index.ts"],
      "@dashwise/sdk/lib/*": ["../../packages/sdk/lib/*"],
      "@dashwise/sdk/data/*": ["../../packages/sdk/src/data/*"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}