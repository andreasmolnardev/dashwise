{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "rootDir": "./src",
    "noEmit": false,
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "lib": ["esnext"],
    "types": [
      "bun"
    ],
    "paths": {
      "@dashwise/assets": ["../../packages/assets/index.ts"],
      "@dashwise/assets/*": ["../../packages/assets/*"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
