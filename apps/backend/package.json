{
  "name": "@dashwise/backend",
  "version": "1.0.0",
  "description": "Bun backend for Dashwise (REST + Pocketbase spawner)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "generate": "bun --cwd ../.. run generate",
    "generate:openapi": "bun run generate",
    "build": "bunx -p typescript@5.9.3 tsc -p tsconfig.json",
    "lint": "eslint . --quiet",
    "lint:all": "eslint ."
  },
  "dependencies": {
    "@dashwise/assets": "workspace:*",
    "@dashwise/integrationskit": "workspace:*",
    "@dashwise/types": "workspace:*",
    "@gonetone/get-youtube-id-by-url": "^2.0.0",
    "hono": "^4.6.14",
    "pocketbase": "^0.26.8",
    "rss-parser": "^3.12.0",
    "sharp": "^0.34.3",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.17.0",
    "ts-caldav": "^0.3.7",
    "yaml": "^2.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ssh2": "^1.15.5",
    "@types/speakeasy": "^2.0.10"
  }
}
