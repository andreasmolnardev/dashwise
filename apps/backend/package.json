{
  "name": "@dashwise/backend",
  "version": "1.0.0",
  "description": "Bun backend for Dashwise (tRPC + Pocketbase spawner)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dashwise/sdk": "workspace:*",
    "@hono/trpc-server": "^0.3.3",
    "@trpc/server": "^11.16.0",
    "dotenv": "^17.2.3",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
