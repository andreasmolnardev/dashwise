{
    "date": {
        "displayName": "Date",
        "description": "Showing the current date in a specified format",
        "properties": {
            "format": "as:dateformat"
        },
        "exampleProps": {
            "format": "MM/DD/YYYY"
        }
    },
    "greeting": {
        "displayName": "Greeting",
        "description": "Pretty self-explanatory"
    },
    "local-timezone": {
        "displayName": "Local Timezone",
        "description": "Displays the user's current timezone"
    },
    "weather": {
        "displayName": "Weather",
        "description": "Displaying the current weather condition at a given place",
        "exampleProps": {
            "location": {
                "name": "Munich",
                "coordinates":  "48.13371667563365, 11.572037161760225"
            },
            "unit": "c",
            "showLocation": false
        },
        "properties": {
            "location": "as:location",
            "unit": "f|c",
            "showLocation": "as:bool"
        }
    },
    "world-clock": {
        "displayName": "World Clock",
        "description": "Shows the time at a specified place",
        "exampleProps": {
            "location": "New York, NY",
            "timezone": "America/New_York"
        },
        "properties": {
            "location": "string",
            "timezone": "as:tz"
        }
    }
}