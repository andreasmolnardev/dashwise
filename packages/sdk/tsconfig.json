{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@dashwise/sdk": ["./index.ts"],
      "@dashwise/sdk/index": ["./index.ts"],
      "@dashwise/sdk/lib/*": ["./lib/*"],
      "@dashwise/sdk/data/*": ["./data/*"]
    }
  },
  "include": ["index.ts", "data/**/*", "lib/**/*", "types/**/*"],
  "exclude": ["dist"]
}
