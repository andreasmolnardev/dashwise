{
  "name": "@dashwise/sdk",
  "version": "0.5.1",
  "description": "The sdk seamlessly connecting dashwise clients to the pocketbase backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dashwise/assets": "workspace:*",
    "@dashwise/types": "workspace:*",
    "@gonetone/get-youtube-id-by-url": "^2.0.0",
    "pocketbase": "^0.26.8",
    "rss-parser": "^3.12.0",
    "sharp": "^0.34.3",
    "speakeasy": "^2.0.0",
    "yaml": "^2.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js",
      "default": "./dist/data/*.js"
    }
  }
}
